# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (if ever ejected / prebuilt)
android/
ios/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# EAS
.eas-build-local

# Logs
*.log

# Vault data — never commit decrypted/encrypted user photos or local test exports
cli/output/
*.dat

# Editor
.vscode/
.idea/
*.swp
