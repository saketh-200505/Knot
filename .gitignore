# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (if ever ejected / prebuilt)
android/
ios/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase / FCM credentials
# google-services.json is client-side config (Firebase project id, API
# key, app id). It's baked into every APK anyway, so committing it is a
# common trade-off for personal projects; if you fork this repo, get
# your own from Firebase Console. Keeping it tracked lets CI build
# without base64 secret gymnastics.
#
# service-account.json is the ADMIN key — lets anyone send FCM messages
# and read/write your Firebase DB as project owner. NEVER commit it.
# It goes to the Expo dashboard via `eas credentials` and nowhere else.
service-account*.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo

# EAS
.eas-build-local

# Logs
*.log

# Vault data — never commit decrypted/encrypted user photos or local test exports
cli/output/
*.dat

# Editor
.vscode/
.idea/
*.swp
