{
  "expo": {
    "name": "Knot",
    "slug": "knot",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.knot.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Knot needs photo access to import images.",
        "NSPhotoLibraryAddUsageDescription": "Knot needs this to save exported photos.",
        "NSCameraUsageDescription": "Knot can optionally use your camera."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080a0f"
      },
      "package": "com.knot.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Knot needs access to select photos for your vault."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Knot to save exported photos.",
          "savePhotosPermission": "Allow Knot to save exported photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A84FF"
        }
      ],
      "./plugins/withFlagSecure"
    ],
    "extra": {
      "eas": {
        "projectId": "96cda92b-7757-4255-922e-ede94993c837"
      }
    },
    "owner": "sak3th"
  }
}
